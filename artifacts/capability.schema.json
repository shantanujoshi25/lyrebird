{
  "$defs": {
    "ConditionDetector": {
      "properties": {
        "by": {
          "enum": [
            "text",
            "role",
            "url_pattern"
          ],
          "title": "By",
          "type": "string"
        },
        "match": {
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "by",
        "match"
      ],
      "title": "ConditionDetector",
      "type": "object"
    },
    "InputParam": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "InputParam",
      "type": "object"
    },
    "KnownCondition": {
      "properties": {
        "code": {
          "$ref": "#/$defs/OutcomeCode"
        },
        "klass": {
          "$ref": "#/$defs/OutcomeClass"
        },
        "detector": {
          "$ref": "#/$defs/ConditionDetector"
        },
        "on_detect": {
          "enum": [
            "return_outcome",
            "dismiss",
            "retry_backoff",
            "relogin",
            "escalate"
          ],
          "title": "On Detect",
          "type": "string"
        },
        "max_retries": {
          "default": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "klass",
        "detector",
        "on_detect"
      ],
      "title": "KnownCondition",
      "type": "object"
    },
    "LocatorCandidate": {
      "properties": {
        "strategy": {
          "$ref": "#/$defs/LocatorStrategy"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "strategy",
        "confidence"
      ],
      "title": "LocatorCandidate",
      "type": "object"
    },
    "LocatorSpec": {
      "properties": {
        "semantic_id": {
          "title": "Semantic Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/LocatorCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "semantic_id",
        "candidates"
      ],
      "title": "LocatorSpec",
      "type": "object"
    },
    "LocatorStrategy": {
      "description": "The A12 invariant lives here: every member must be answerable on web AND desktop-AX.\n\nCSS and XPath are deliberately ABSENT \u2014 they have no desktop-AX equivalent, so a\ncandidate using them would make the artifact web-only. Because this is an enum, any\nnon-member value (e.g. \"css\") fails Pydantic validation automatically \u2014 the surface-\nagnostic invariant is enforced structurally, not by a manual check.",
      "enum": [
        "role_name",
        "visible_text",
        "label_proximity",
        "relative_anchor",
        "bbox"
      ],
      "title": "LocatorStrategy",
      "type": "string"
    },
    "OutcomeClass": {
      "enum": [
        "business_outcome",
        "recoverable",
        "hard"
      ],
      "title": "OutcomeClass",
      "type": "string"
    },
    "OutcomeCode": {
      "enum": [
        "NOT_FOUND",
        "VALIDATION_ERROR",
        "PERMISSION_DENIED",
        "INTERSTITIAL",
        "SESSION_EXPIRED",
        "TRANSIENT",
        "APP_ERROR",
        "UNKNOWN_DIALOG",
        "LOCATOR_NOT_FOUND",
        "CHECKPOINT_FAILED"
      ],
      "title": "OutcomeCode",
      "type": "string"
    },
    "OutputSpec": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "extract": {
          "$ref": "#/$defs/LocatorSpec"
        },
        "transform": {
          "anyOf": [
            {
              "enum": [
                "text",
                "number",
                "currency"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform"
        }
      },
      "required": [
        "name",
        "type",
        "extract"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "discovery_run_id": {
          "title": "Discovery Run Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "required": [
        "discovery_run_id",
        "model",
        "created_at",
        "viewport"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "safe",
        "risky"
      ],
      "title": "Risk",
      "type": "string"
    },
    "Step": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "action": {
          "enum": [
            "click",
            "type",
            "select",
            "scroll",
            "navigate",
            "press"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "wait_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "postcondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OutcomeCode"
          },
          "title": "On Conditions",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "safe"
        },
        "provenance": {
          "default": "model",
          "enum": [
            "model",
            "human"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "page_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Fingerprint"
        }
      },
      "required": [
        "index",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "properties": {
        "app_id": {
          "title": "App Id",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        },
        "entry_url_pattern": {
          "title": "Entry Url Pattern",
          "type": "string"
        },
        "tenant": {
          "default": "base",
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "vendor",
        "entry_url_pattern"
      ],
      "title": "Target",
      "type": "object"
    },
    "Viewport": {
      "properties": {
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "device_scale_factor": {
          "default": 1.0,
          "title": "Device Scale Factor",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Viewport",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capability_id": {
      "title": "Capability Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputParam"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputSpec"
      },
      "title": "Outputs",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "known_conditions": {
      "items": {
        "$ref": "#/$defs/KnownCondition"
      },
      "title": "Known Conditions",
      "type": "array"
    },
    "success_checkpoint": {
      "$ref": "#/$defs/ConditionDetector"
    },
    "risk_summary": {
      "title": "Risk Summary",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "capability_id",
    "name",
    "description",
    "target",
    "inputs",
    "outputs",
    "steps",
    "known_conditions",
    "success_checkpoint",
    "risk_summary",
    "provenance"
  ],
  "title": "Capability",
  "type": "object"
}