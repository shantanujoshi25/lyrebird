{
  "$defs": {
    "ConditionDetector": {
      "properties": {
        "by": {
          "enum": [
            "text",
            "role",
            "url_pattern"
          ],
          "title": "By",
          "type": "string"
        },
        "match": {
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "by",
        "match"
      ],
      "title": "ConditionDetector",
      "type": "object"
    },
    "DurableLocator": {
      "description": "An ordered set of concrete handles to ONE DOM node, captured from the node itself at\ndiscovery. Replay tries candidates in order; the first that resolves to exactly one element\nwins, and its index is the fallback depth (drift telemetry, \u00a77). Used for BOTH step targets\nand output values \u2014 one uniform locator, no per-purpose grammar.",
      "properties": {
        "semantic_id": {
          "title": "Semantic Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/LocatorCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "semantic_id",
        "candidates"
      ],
      "title": "DurableLocator",
      "type": "object"
    },
    "InputParam": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "InputParam",
      "type": "object"
    },
    "KnownCondition": {
      "properties": {
        "code": {
          "$ref": "#/$defs/OutcomeCode"
        },
        "klass": {
          "$ref": "#/$defs/OutcomeClass"
        },
        "detector": {
          "$ref": "#/$defs/ConditionDetector"
        },
        "on_detect": {
          "enum": [
            "return_outcome",
            "dismiss",
            "retry_backoff",
            "relogin",
            "escalate"
          ],
          "title": "On Detect",
          "type": "string"
        },
        "max_retries": {
          "default": 0,
          "title": "Max Retries",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "klass",
        "detector",
        "on_detect"
      ],
      "title": "KnownCondition",
      "type": "object"
    },
    "LocatorCandidate": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/LocatorKind"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LocatorCandidate",
      "type": "object"
    },
    "LocatorKind": {
      "description": "How to re-find an element. These are the durable handles the discovery pass reads\nSTRAIGHT OFF the DOM node the LLM pointed at \u2014 most-stable first. They map cleanly to both\nweb (Playwright) and desktop-AX, so an artifact isn't web-only:\n\n  css   -> a stable structural selector: #id, [name=], [data-*=] (NOT brittle class chains)\n  role  -> ARIA role + accessible name (Playwright get_by_role; AX has the same pair)\n  text  -> exact visible text (get_by_text; AX name match)\n  label -> a value cell anchored on its stable LABEL (\"the cell next to 'Savings'\") \u2014 the\n           only durable handle a bare value cell has, since its own text is the value and\n           changes per run. `value` holds the label text.\n  nth   -> tag + ordinal within the frame \u2014 last resort, only when nothing else is stable\n\nWe store several, ordered; replay tries them in order and the winning index is the drift\nsignal (\u00a77). We do NOT synthesize these from reconstructed text \u2014 they come from the real\nnode, which is why old back-office apps (stable DOM) replay reliably.",
      "enum": [
        "css",
        "role",
        "text",
        "label",
        "nth"
      ],
      "title": "LocatorKind",
      "type": "string"
    },
    "OutcomeClass": {
      "enum": [
        "business_outcome",
        "recoverable",
        "hard"
      ],
      "title": "OutcomeClass",
      "type": "string"
    },
    "OutcomeCode": {
      "enum": [
        "NOT_FOUND",
        "VALIDATION_ERROR",
        "PERMISSION_DENIED",
        "INTERSTITIAL",
        "SESSION_EXPIRED",
        "TRANSIENT",
        "APP_ERROR",
        "UNKNOWN_DIALOG",
        "LOCATOR_NOT_FOUND",
        "CHECKPOINT_FAILED"
      ],
      "title": "OutcomeCode",
      "type": "string"
    },
    "OutputSpec": {
      "description": "A declared output: replay resolves `locator` to the SAME DOM node the LLM read at\ndiscovery, reads its text/value, and casts to `type`. The locator is durable (captured off\nthe node), so the value can change per run but the recipe doesn't \u2014 the read stays stable.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurableLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_seen": {
          "default": "",
          "title": "Value Seen",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "discovery_run_id": {
          "title": "Discovery Run Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "required": [
        "discovery_run_id",
        "model",
        "created_at",
        "viewport"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "safe",
        "risky"
      ],
      "title": "Risk",
      "type": "string"
    },
    "Step": {
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "action": {
          "enum": [
            "click",
            "type",
            "select",
            "scroll",
            "navigate",
            "press"
          ],
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DurableLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "wait_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "postcondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDetector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OutcomeCode"
          },
          "title": "On Conditions",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "safe"
        },
        "provenance": {
          "default": "model",
          "enum": [
            "model",
            "human"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "page_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Fingerprint"
        }
      },
      "required": [
        "index",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "properties": {
        "app_id": {
          "title": "App Id",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        },
        "entry_url_pattern": {
          "title": "Entry Url Pattern",
          "type": "string"
        },
        "tenant": {
          "default": "base",
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "vendor",
        "entry_url_pattern"
      ],
      "title": "Target",
      "type": "object"
    },
    "Viewport": {
      "properties": {
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "device_scale_factor": {
          "default": 1.0,
          "title": "Device Scale Factor",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Viewport",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capability_id": {
      "title": "Capability Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputParam"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputSpec"
      },
      "title": "Outputs",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "known_conditions": {
      "items": {
        "$ref": "#/$defs/KnownCondition"
      },
      "title": "Known Conditions",
      "type": "array"
    },
    "success_checkpoint": {
      "$ref": "#/$defs/ConditionDetector"
    },
    "risk_summary": {
      "title": "Risk Summary",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "capability_id",
    "name",
    "description",
    "target",
    "inputs",
    "outputs",
    "steps",
    "known_conditions",
    "success_checkpoint",
    "risk_summary",
    "provenance"
  ],
  "title": "Capability",
  "type": "object"
}