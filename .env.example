# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic API key — required only for the real discovery run (C3). Replay/policy/
# schema/handoff tests run with NO LLM and need no key.
ANTHROPIC_API_KEY=

# Model string — read from env, never hard-coded in code.
# Catalog-verified IDs: claude-sonnet-4-6 (dev/smoke, cheap), claude-opus-4-8 (evidence run).
LYREBIRD_MODEL=claude-sonnet-4-6

# Mock app fake credentials (not real; used only by the local mock).
MOCK_USERNAME=teller
MOCK_PASSWORD=demo-pass-not-secret
